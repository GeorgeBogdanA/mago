# Static analysis for symfony-api. Run: vendor/bin/phpstan analyse (see CLAUDE.md).
# Extensions are included by hand: no phpstan/extension-installer Composer plugin.
includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: max
    # Our code. Not bin/console and public/index.php: Symfony skeleton entry points.
    paths:
        - config/
        - src/
        - tests/
    excludePaths:
        # Generated by Symfony on cache warmup.
        - config/reference.php
    symfony:
        # Lets PHPStan know the real services and parameters. Built by any bin/console command in dev.
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml
    tmpDir: var/cache/phpstan
