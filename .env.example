# Copy to .env (never committed) and set real values: cp .env.example .env
# Read by docker compose. Use letters and digits only in the password (it goes into a URL).
POSTGRES_DB=mago
POSTGRES_USER=mago
POSTGRES_PASSWORD=change-me
# Generate with: openssl rand -hex 16
APP_SECRET=change-me
# Host port for the API (bound to 127.0.0.1 only)
API_HTTP_PORT=8080
# Your host user, so files created by the container stay yours: id -u / id -g
UID=1000
GID=1000
